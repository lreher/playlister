{
  "name": "playlister",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "sync": "node scripts/sync.js",
    "fetch-events": "node scripts/fetchEvents.js",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "migrate:rollback": "knex migrate:rollback",
    "deploy": "ssh playlister-prod 'bash playlister/scripts/deploy.sh'",
    "build": "esbuild client/index.jsx --bundle --outfile=static/bundle.js --jsx=automatic --jsx-import-source=preact --minify",
    "watch": "esbuild client/index.jsx --bundle --outfile=static/bundle.js --jsx=automatic --jsx-import-source=preact --watch",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "find-my-way": "^9.9.0",
    "knex": "^3.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "eslint": "^10.10.0"
  }
}
