SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
PORT=3000

# Signs/verifies the session cookie (sources/session.js) — any random 32+
# byte value, e.g. `openssl rand -hex 32`. Keep this the same across
# restarts/deploys or every existing session gets invalidated.
SESSION_SECRET=

# Gates the session cookie's Secure attribute (sources/session.js) — set to
# `production` on the droplet (served over HTTPS via Cloudflare Tunnel).
# Leave unset for local dev over http://127.0.0.1.
NODE_ENV=

# The one Spotify user id allowed to use the Delete button (wipes the
# ENTIRE database for every user, not just their own — see
# routes/index.js's /api/wipe-database). Leave unset to disable it
# entirely.
ADMIN_USER_ID=
