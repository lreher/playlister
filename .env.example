SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
PORT=3000

# Registers /login and /callback. Leave this on for local dev. On a public
# deploy, leave it unset (or false) — flip it on temporarily only when you
# actually need to (re-)authenticate, then back off. See routes/index.js.
ENABLE_LOGIN=true
